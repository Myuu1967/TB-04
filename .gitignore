# KiCAD auto-backups
*-backups/

# KiCADローカル履歴（VS Code Local History等・ユーザー領分の埋め込みgitリポジトリ）
.history/

# KiCAD cache
fp-info-cache

# Local project settings (window state, layer visibility)
*.kicad_prl

# Non-KiCAD files
amp/
*.et
*.csv
*.docx
*.PDF

# Gerber・ドリル出力（製造用の生成物。回路図/基板ファイルから再生成可）
*-gerber/
*-gerber.zip
*.gbr
*.gbrjob
*.drl
peripherals/7segIF/hardware/7segIF.zip

# AIレビュー用の生成物（ネットリスト＋ERCの自動出力。回路図から再生成可）
ai-review/
**/hardware/**/*.xml

# KiCAD ロックファイル（編集中のみ生成される一時ファイル）
*.lck

# Office 一時ロックファイル
~$*

# Python
__pycache__/
*.pyc

# 個人写真・実機撮影動画（誤コミット防止・容量が大きいためローカル管理）
PXL_*.jpg
*.jpeg
PXL_*.mp4
*.mp4

